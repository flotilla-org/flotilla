# Rust (ADR 0062, B5): rustup plus a read-only default toolchain.
#
# The image must work for any UID with only HOME supplied at runtime, keep its
# default toolchain read-only, and still let a checkout's rust-toolchain.toml
# install other releases on demand. rustup has one RUSTUP_HOME, so:
#
# - Build time installs into /opt/flotilla/toolchains/rust (RUSTUP_HOME=rustup,
#   CARGO_HOME=cargo there), then makes the tree read-only. Only the proxies'
#   directory goes on PATH; RUSTUP_HOME and CARGO_HOME are NOT set in ENV.
# - At runtime both therefore default under the provider's HOME
#   ($HOME/.rustup, $HOME/.cargo): registry caches, `cargo install` output and
#   on-demand toolchains are writable state there, persisted per host/volume.
# - The launch prelude prelude.d/40-rust.sh (an action, not environment)
#   links the baked toolchain into $HOME/.rustup/toolchains under its
#   distributable name and sets it as the default when no default exists.
#   A checkout pinning this release therefore resolves offline to the baked
#   toolchain, while another pin downloads into $HOME.
# - The baked toolchain carries rustfmt, clippy, llvm-tools-preview and the
#   wasm32-unknown-unknown target. A checkout pinning this release with a
#   component beyond those cannot add it (the link target is read-only); add
#   it in a project layer at build time instead, as root with
#   RUSTUP_HOME=/opt/flotilla/toolchains/rust/rustup.
FROM ${BASE}
ARG TARGETARCH
RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) arch=x86_64 ;; \
        arm64) arch=aarch64 ;; \
        *) echo "unsupported Rust architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    root=/opt/flotilla/toolchains/rust; \
    export RUSTUP_HOME="${root}/rustup" CARGO_HOME="${root}/cargo"; \
    curl -fsSL "$(printf '%s' "${PIN_RUSTUP_URL}" | sed "s/{arch}/${arch}/g")" -o /tmp/rustup-init; \
    printf '%s  %s\n' "${PIN_RUSTUP_SHA256}" /tmp/rustup-init | sha256sum --check --strict -; \
    curl -fsSL "${PIN_RUST_URL}" -o /tmp/channel-rust.toml; \
    printf '%s  %s\n' "${PIN_RUST_SHA256}" /tmp/channel-rust.toml | sha256sum --check --strict -; \
    chmod 0755 /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain "${PIN_RUST_VERSION}" \
        --component rustfmt,clippy,llvm-tools-preview \
        --target wasm32-unknown-unknown; \
    toolchain="${PIN_RUST_VERSION}-${arch}-unknown-linux-gnu"; \
    test -d "${RUSTUP_HOME}/toolchains/${toolchain}"; \
    printf '%s\n' "${toolchain}" > "${root}/default-toolchain"; \
    rm -rf /tmp/rustup-init /tmp/channel-rust.toml \
        "${RUSTUP_HOME}/downloads" "${RUSTUP_HOME}/tmp" "${CARGO_HOME}/registry"; \
    chmod -R a+rX,go-w "${root}"
COPY --from=rust --chmod=0644 prelude.d/40-rust.sh /etc/flotilla/prelude.d/40-rust.sh
ENV PATH="/opt/flotilla/bin:/opt/flotilla/toolchains/rust/cargo/bin:${PATH}"
