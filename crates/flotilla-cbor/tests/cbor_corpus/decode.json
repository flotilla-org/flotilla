          "name": "setup message of 65,536 bytes, just inside",
          "limits": "setup",
          "hex": [
            "79fffd",
            {
              "repeat": "61",
              "count": 65533
            }
          ],
          "expect": "accept"
        },
        {
          "name": "setup message of 65,537 bytes, just over",
          "limits": "setup",
          "hex": [
            "79fffe",
            {
              "repeat": "61",
              "count": 65534
            }
          ],
          "expect": "message-limit"
        },
        {
          "name": "setup descriptor of 4,096 bytes, just inside",
          "limits": "setup",
          "hex": [
            "591000",
            {
              "repeat": "00",
              "count": 4096
            }
          ],
          "expect": "accept"
        },
        {
          "name": "setup descriptor of 4,097 bytes, just over",
          "limits": "setup",
          "hex": [
            "591001",
            {
              "repeat": "00",
              "count": 4097
            }
          ],
          "expect": "byte-string-limit"
        },
        {
          "name": "setup descriptor over the limit fails before its bytes",
          "limits": "setup",
          "hex": "591001",
          "expect": "byte-string-limit"
        },
        {
          "name": "setup descriptor of 4,097 bytes nested in a message",
          "limits": "setup",
          "hex": [
            "a26164",
            "591001",
            {
              "repeat": "00",
              "count": 4097
            },
            "6474797065",
            "6568656c6c6f"
          ],
          "expect": "byte-string-limit"
        },
        {
          "name": "setup text of 4,097 bytes is not a descriptor",
          "limits": "setup",
          "hex": [
            "791001",
            {
              "repeat": "61",
              "count": 4097
            }
          ],
          "expect": "accept"
        },
        {
          "name": "depth 300 fails without exhausting the stack",
          "limits": "default",
          "hex": [
            {
              "repeat": "81",
              "count": 300
            },
            "80"
          ],
          "expect": "depth-limit"
        },
        {
          "name": "setup descriptor of 4,097 bytes in a non-shortest head",
          "limits": "setup",
          "hex": [
            "5a00001001",
            {
              "repeat": "00",
              "count": 4097
            }
          ],
          "expect": "byte-string-limit"
        }
      ]
    }
  ]
}
