    {
      "name": "limits",
      "description": "Limits, checked against declared sizes before anything is allocated for them. Every reader, safe or canonical, gives expect.",
      "vectors": [
        {
          "name": "byte string claims 2^64-1 bytes",
          "limits": "default",
          "hex": "5bffffffffffffffff00",
