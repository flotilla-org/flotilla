{
  "description": "Decoder vectors. Decoding hex under the named limits is accepted or fails with expect; the canonical check gives canonical, or else the same result as expect.",
  "groups": [
    {
      "name": "accepted-not-deterministic",
      "description": "Well-formed input that is not in deterministic form. Safe readers accept it and decode it to diag; the canonical check rejects it with canonical.",
      "vectors": [
        {
          "name": "non-shortest integer: 0 in one byte",
          "limits": "default",
          "hex": "1800",
          "expect": "accept",
          "diag": "0",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: 23 in one byte",
          "limits": "default",
          "hex": "1817",
          "expect": "accept",
          "diag": "23",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: 0 in two bytes",
          "limits": "default",
          "hex": "190000",
          "expect": "accept",
          "diag": "0",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: 255 in two bytes",
          "limits": "default",
          "hex": "1900ff",
          "expect": "accept",
          "diag": "255",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: 65535 in four bytes",
          "limits": "default",
          "hex": "1a0000ffff",
          "expect": "accept",
          "diag": "65535",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: 2^32-1 in eight bytes",
          "limits": "default",
          "hex": "1b00000000ffffffff",
          "expect": "accept",
          "diag": "4294967295",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: -1 in one byte",
          "limits": "default",
          "hex": "3800",
          "expect": "accept",
          "diag": "-1",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: -24 in one byte",
          "limits": "default",
          "hex": "3817",
          "expect": "accept",
          "diag": "-24",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: -256 in two bytes",
          "limits": "default",
          "hex": "3900ff",
          "expect": "accept",
          "diag": "-256",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest integer: -2^32 in eight bytes",
          "limits": "default",
          "hex": "3b00000000ffffffff",
          "expect": "accept",
          "diag": "-4294967296",
          "canonical": "non-shortest-integer"
        },
        {
          "name": "non-shortest length: byte string length in one byte",
          "limits": "default",
          "hex": "5800",
          "expect": "accept",
          "diag": "h''",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest length: byte string length 23 in one byte",
          "limits": "default",
          "hex": "58170000000000000000000000000000000000000000000000",
          "expect": "accept",
          "diag": "h'0000000000000000000000000000000000000000000000'",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest length: text length in one byte",
          "limits": "default",
          "hex": "780161",
          "expect": "accept",
          "diag": "\"a\"",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest length: text length in two bytes",
          "limits": "default",
          "hex": "79000161",
          "expect": "accept",
          "diag": "\"a\"",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest length: array length in one byte",
          "limits": "default",
          "hex": "9800",
          "expect": "accept",
          "diag": "[]",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest length: array length in four bytes",
          "limits": "default",
          "hex": "9a0000000100",
          "expect": "accept",
          "diag": "[0]",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest length: map length in one byte",
          "limits": "default",
          "hex": "b800",
          "expect": "accept",
          "diag": "{}",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest length: map length in eight bytes",
          "limits": "default",
          "hex": "bb0000000000000000",
          "expect": "accept",
          "diag": "{}",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest float: 1.5 as f32",
          "limits": "default",
          "hex": "fa3fc00000",
          "expect": "accept",
          "diag": "1.5",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: 1.5 as f64",
          "limits": "default",
          "hex": "fb3ff8000000000000",
          "expect": "accept",
          "diag": "1.5",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: Infinity as f32",
          "limits": "default",
          "hex": "fa7f800000",
          "expect": "accept",
          "diag": "Infinity",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: -Infinity as f64",
          "limits": "default",
          "hex": "fbfff0000000000000",
          "expect": "accept",
          "diag": "-Infinity",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: -0.0 as f32",
          "limits": "default",
          "hex": "fa80000000",
          "expect": "accept",
          "diag": "-0.0",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: -0.0 as f64",
          "limits": "default",
          "hex": "fb8000000000000000",
          "expect": "accept",
          "diag": "-0.0",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: 2^-24 as f64",
          "limits": "default",
          "hex": "fb3e70000000000000",
          "expect": "accept",
          "diag": "5.9604644775390625e-8",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: 100000.5 as f64",
          "limits": "default",
          "hex": "fb40f86a0800000000",
          "expect": "accept",
          "diag": "100000.5",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: 2^64 as f64",
          "limits": "default",
          "hex": "fb43f0000000000000",
          "expect": "accept",
          "diag": "1.8446744073709552e19",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: 1.0 as f64",
          "limits": "default",
          "hex": "fb3ff0000000000000",
          "expect": "accept",
          "diag": "1.0",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: 1.0 as f32",
          "limits": "default",
          "hex": "fa3f800000",
          "expect": "accept",
          "diag": "1.0",
          "canonical": "non-shortest-float"
        },
        {
          "name": "non-shortest float: 0.0 as f64",
          "limits": "default",
          "hex": "fb0000000000000000",
          "expect": "accept",
          "diag": "0.0",
          "canonical": "non-shortest-float"
        },
        {
          "name": "unsorted keys",
          "limits": "default",
          "hex": "a2616201616101",
          "expect": "accept",
          "diag": "{\"b\": 1, \"a\": 1}",
          "canonical": "unsorted-keys"
        },
        {
          "name": "unsorted keys, longer first",
          "limits": "default",
          "hex": "a262616101617902",
          "expect": "accept",
          "diag": "{\"aa\": 1, \"y\": 2}",
          "canonical": "unsorted-keys"
        },
        {
          "name": "unsorted keys in nested map",
          "limits": "default",
          "hex": "a16161a2616201616101",
          "expect": "accept",
          "diag": "{\"a\": {\"b\": 1, \"a\": 1}}",
          "canonical": "unsorted-keys"
        },
        {
          "name": "non-shortest key length",
          "limits": "default",
          "hex": "a1780161f6",
          "expect": "accept",
          "diag": "{\"a\": null}",
          "canonical": "non-shortest-length"
        },
        {
          "name": "non-shortest integer inside a message",
          "limits": "default",
          "hex": "a26178181764747970656568656c6c6f",
          "expect": "accept",
          "diag": "{\"x\": 23, \"type\": \"hello\"}",
          "canonical": "non-shortest-integer"
        }
      ]
    },
