# Curated runtime for contained Flotilla crew.
#
# Keep the layers in dependency/change-frequency order. In particular, adapter
# version arguments belong immediately before the final layer so an adapter
# update can reuse the much larger language-toolchain layers.

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# 1. Base OS, trust store, and source/network clients.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/*

# 2. Language toolchains used to verify crew work.
ARG RUST_VERSION=1.94.1
ARG RUST_NIGHTLY=nightly-2026-03-12
ARG NODE_VERSION=24.18.0
ARG TARGETARCH

ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH="/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libssl-dev \
        pkg-config \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rustup component add clippy \
    && rustup toolchain install "${RUST_NIGHTLY}" --profile minimal \
        --component rustfmt --component llvm-tools-preview

RUN case "${TARGETARCH}" in \
        amd64) node_arch=x64 ;; \
        arm64) node_arch=arm64 ;; \
        *) echo "unsupported Node.js architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && node_archive="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
    && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${node_archive}" \
    && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
    && grep " ${node_archive}$" SHASUMS256.txt | sha256sum --check --strict - \
    && tar -xJf "${node_archive}" -C /usr/local --strip-components=1 \
    && rm "${node_archive}" SHASUMS256.txt \
    && node --version \
    && npm --version

# 3. Forge CLI and day-to-day utilities.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        file \
        gh \
        jq \
        less \
        openssh-client \
        ripgrep \
        unzip \
        zsh \
    && rm -rf /var/lib/apt/lists/*

# 4. Agent adapters. Keep this fastest-moving layer last.
ARG CLAUDE_CODE_VERSION=2.1.220
ARG CODEX_VERSION=0.145.0

RUN npm install --global \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
        "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force

ENV DISABLE_AUTOUPDATER=1
ENV SHELL=/bin/zsh

# Build-time smoke check: declaring these adapters in a PlacementPolicy is a
# promise that both entry points are executable in the image.
RUN claude --version \
    && codex --version

WORKDIR /workspace
CMD ["sleep", "infinity"]
