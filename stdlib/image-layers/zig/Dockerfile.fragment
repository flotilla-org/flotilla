# Zig (ADR 0062, shared tier), installed read-only under
# /opt/flotilla/toolchains/zig.
FROM ${BASE}
RUN set -eu; \
    curl -fsSL "${PIN_ZIG_URL}" -o /tmp/zig.tar.xz; \
    printf '%s  %s\n' "${PIN_ZIG_SHA256}" /tmp/zig.tar.xz | sha256sum --check --strict -; \
    mkdir -p /opt/flotilla/toolchains/zig; \
    tar -xJf /tmp/zig.tar.xz -C /opt/flotilla/toolchains/zig --strip-components=1 --no-same-owner; \
    rm /tmp/zig.tar.xz; \
    chmod -R a+rX,go-w /opt/flotilla/toolchains/zig; \
    test "$(/opt/flotilla/toolchains/zig/zig version)" = "${PIN_ZIG_VERSION}"
ENV PATH="/opt/flotilla/bin:/opt/flotilla/toolchains/zig:${PATH}"
