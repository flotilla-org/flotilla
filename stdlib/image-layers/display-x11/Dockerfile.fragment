# Headless X11 (ADR 0062, A9). The launch prelude starts Xvfb on :99 and
# exports DISPLAY; static environment stays in ENV.
FROM ${BASE}
ARG DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libgl1-mesa-dri \
        mesa-utils \
        x11-utils \
        xauth \
        xvfb; \
    rm -rf /var/lib/apt/lists/*
ENV LIBGL_ALWAYS_SOFTWARE=1
COPY --from=display-x11 --chmod=0644 prelude.d/50-display-x11.sh /etc/flotilla/prelude.d/50-display-x11.sh
