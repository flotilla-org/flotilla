# Claude Code harness (ADR 0062, A6). The fetch stage downloads the native
# binary; the output stage copies only its directory with COPY --link, so the
# layer's blob is independent of the layers beneath it.
FROM ${BASE} AS harness-claude-code-fetch
RUN set -eu; \
    dest="/opt/flotilla/harnesses/claude-code/${PIN_CLAUDE_CODE_VERSION}"; \
    mkdir -p "${dest}/bin"; \
    curl -fsSL "${PIN_CLAUDE_CODE_URL}" -o "${dest}/bin/claude"; \
    printf '%s  %s\n' "${PIN_CLAUDE_CODE_SHA256}" "${dest}/bin/claude" | sha256sum --check --strict -; \
    chmod -R a+rX,go-w "${dest}"; \
    chmod 0755 "${dest}/bin/claude"

FROM ${BASE}
COPY --link --from=harness-claude-code-fetch /opt/flotilla/harnesses/claude-code/${PIN_CLAUDE_CODE_VERSION}/ /opt/flotilla/harnesses/claude-code/${PIN_CLAUDE_CODE_VERSION}/
ENV PATH="/opt/flotilla/bin:/opt/flotilla/harnesses/claude-code/${PIN_CLAUDE_CODE_VERSION}/bin:${PATH}"
# The image owns the harness version: a bump is a new layer version (A6).
# The binary is image-managed, so the installer's location checks do not apply.
ENV DISABLE_AUTOUPDATER=1
ENV DISABLE_INSTALLATION_CHECKS=1
