# Formal modelling (ADR 0062, shared tier; requires toolchain:node).
# Everything is baked read-only: QUINT_HOME points at /opt/quint with both
# versioned backend distributions in place, so crews never download backends
# into ~/.quint. Static environment is image ENV; there is no prelude.
FROM ${BASE}
ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends libstdc++6; \
    rm -rf /var/lib/apt/lists/*
COPY --from=formal-modelling --chmod=0644 package.json package-lock.json /opt/quint/npm/
RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) java_arch=x64; evaluator_arch=x86_64 ;; \
        arm64) java_arch=aarch64; evaluator_arch=aarch64 ;; \
        *) echo "unsupported formal-modelling architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    java_home=/opt/java; \
    quint_home=/opt/quint; \
    evaluator_dir="${quint_home}/rust-evaluator-v${PIN_QUINT_EVALUATOR_VERSION}"; \
    apalache_dir="${quint_home}/apalache-dist-${PIN_APALACHE_VERSION}"; \
    mkdir -p "${java_home}" "${evaluator_dir}" "${apalache_dir}" "${quint_home}/bin"; \
    curl -fsSL "$(printf '%s' "${PIN_JDK_URL}" | sed "s/{arch}/${java_arch}/g")" -o /tmp/jdk.tar.gz; \
    printf '%s  %s\n' "${PIN_JDK_SHA256}" /tmp/jdk.tar.gz | sha256sum --check --strict -; \
    tar -xzf /tmp/jdk.tar.gz -C "${java_home}" --strip-components=1 --no-same-owner; \
    curl -fsSL "$(printf '%s' "${PIN_QUINT_EVALUATOR_URL}" | sed "s/{arch}/${evaluator_arch}/g")" -o /tmp/evaluator.tar.gz; \
    printf '%s  %s\n' "${PIN_QUINT_EVALUATOR_SHA256}" /tmp/evaluator.tar.gz | sha256sum --check --strict -; \
    tar -xzf /tmp/evaluator.tar.gz -C "${evaluator_dir}" --no-same-owner; \
    curl -fsSL "${PIN_APALACHE_URL}" -o /tmp/apalache.tgz; \
    printf '%s  %s\n' "${PIN_APALACHE_SHA256}" /tmp/apalache.tgz | sha256sum --check --strict -; \
    tar -xzf /tmp/apalache.tgz -C "${apalache_dir}" --no-same-owner; \
    curl -fsSL "${PIN_TLC_URL}" -o "${quint_home}/tla2tools.jar"; \
    printf '%s  %s\n' "${PIN_TLC_SHA256}" "${quint_home}/tla2tools.jar" | sha256sum --check --strict -; \
    ln -s "${apalache_dir}/apalache/bin/apalache-mc" "${quint_home}/bin/apalache-mc"; \
    npm_config_cache=/tmp/npm-cache npm ci --prefix "${quint_home}/npm" --ignore-scripts --no-audit --no-fund; \
    test "$("${quint_home}/npm/node_modules/.bin/quint" --version)" = "${PIN_QUINT_VERSION}"; \
    ln -s ../npm/node_modules/.bin/quint "${quint_home}/bin/quint"; \
    rm -rf /tmp/jdk.tar.gz /tmp/evaluator.tar.gz /tmp/apalache.tgz /tmp/npm-cache; \
    chmod -R a+rX,a-w "${java_home}" "${quint_home}"
# Created first: COPY --chmod would give a directory it creates the files' mode.
RUN install -d -m 0755 /opt/flotilla/formal-modelling
COPY --from=formal-modelling --chmod=0644 smoke.qnt smoke.tla smoke.cfg /opt/flotilla/formal-modelling/
COPY --from=formal-modelling --chmod=0755 probe.sh /opt/flotilla/formal-modelling/probe.sh
COPY --from=formal-modelling --chmod=0755 tlc /usr/local/bin/tlc
ENV JAVA_HOME=/opt/java
ENV QUINT_HOME=/opt/quint
ENV PATH="/opt/flotilla/bin:/opt/java/bin:/opt/quint/bin:${PATH}"
