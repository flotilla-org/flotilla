# Codex harness (ADR 0062, A6). The fetch stage downloads and unpacks the
# native package; the output stage copies only that directory with
# COPY --link, so the layer's blob is independent of the layers beneath it.
FROM ${BASE} AS harness-codex-fetch
ARG TARGETARCH
RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) arch=x86_64 ;; \
        arm64) arch=aarch64 ;; \
        *) echo "unsupported Codex architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "$(printf '%s' "${PIN_CODEX_URL}" | sed "s/{arch}/${arch}/g")" -o /tmp/codex.tar.gz; \
    printf '%s  %s\n' "${PIN_CODEX_SHA256}" /tmp/codex.tar.gz | sha256sum --check --strict -; \
    dest="/opt/flotilla/harnesses/codex/${PIN_CODEX_VERSION}"; \
    mkdir -p "${dest}"; \
    tar -xzf /tmp/codex.tar.gz -C "${dest}" --no-same-owner; \
    rm /tmp/codex.tar.gz; \
    test -x "${dest}/bin/codex"; \
    chmod -R a+rX,go-w "${dest}"

FROM ${BASE}
COPY --link --from=harness-codex-fetch /opt/flotilla/harnesses/codex/${PIN_CODEX_VERSION}/ /opt/flotilla/harnesses/codex/${PIN_CODEX_VERSION}/
ENV PATH="/opt/flotilla/bin:/opt/flotilla/harnesses/codex/${PIN_CODEX_VERSION}/bin:${PATH}"
