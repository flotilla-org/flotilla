+
+  quint-scenarios:
+    name: Quint scenarios
+    runs-on: ubuntu-latest
+    needs: [changes, stack-scope]
+    if: ${{ !cancelled() && needs.changes.outputs.quint == 'true' && needs.stack-scope.outputs.full != 'false' }}
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v7
+      - run: echo "QUINT_RUN_DIR=$RUNNER_TEMP/quint-fast" >> "$GITHUB_ENV"
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+      - uses: actions/cache@v6
+        with:
+          path: |
+            ~/.npm
+            ~/.quint
+          key: quint-0.33.0-apalache-0.62.1
+      - name: Install pinned Quint
+        run: |
+          npm install --prefix "$RUNNER_TEMP/quint" @informalsystems/quint@0.33.0
+          echo "$RUNNER_TEMP/quint/node_modules/.bin" >> "$GITHUB_PATH"
+      - name: Check scenarios
+        run: ci/quint/with-server.sh specs/primitives/check.sh --part scenarios
+      - uses: actions/upload-artifact@v4
+        with:
+          name: quint-scenarios
+          path: ${{ runner.temp }}/quint-fast/*.itf.json
+          if-no-files-found: error
+          retention-days: 1
+
+  quint-graphs:
+    name: Quint graph export
+    runs-on: ubuntu-latest
+    needs: [changes, stack-scope]
+    if: ${{ !cancelled() && needs.changes.outputs.quint == 'true' && needs.stack-scope.outputs.full != 'false' }}
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v7
+      - run: echo "QUINT_RUN_DIR=$RUNNER_TEMP/quint-fast" >> "$GITHUB_ENV"
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+      - uses: actions/cache@v6
+        with:
+          path: |
+            ~/.npm
+            ~/.quint
+          key: quint-0.33.0-apalache-0.62.1
+      - name: Install pinned Quint
+        run: |
+          npm install --prefix "$RUNNER_TEMP/quint" @informalsystems/quint@0.33.0
+          echo "$RUNNER_TEMP/quint/node_modules/.bin" >> "$GITHUB_PATH"
+      - name: Check graph export
+        run: ci/quint/with-server.sh specs/primitives/check.sh --part graphs
+      - uses: actions/upload-artifact@v4
+        with:
+          name: quint-graphs
+          path: ${{ runner.temp }}/quint-fast/graphs/*.graph.json
+          if-no-files-found: error
+          retention-days: 1
+
+  quint-mutants:
+    name: Quint mutants
+    runs-on: ubuntu-latest
+    needs: [changes, stack-scope]
+    if: ${{ !cancelled() && needs.changes.outputs.quint == 'true' && needs.stack-scope.outputs.full != 'false' }}
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v7
+      - run: echo "QUINT_RUN_DIR=$RUNNER_TEMP/quint-fast" >> "$GITHUB_ENV"
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+      - uses: actions/cache@v6
+        with:
+          path: |
+            ~/.npm
+            ~/.quint
+          key: quint-0.33.0-apalache-0.62.1
+      - name: Install pinned Quint
+        run: |
+          npm install --prefix "$RUNNER_TEMP/quint" @informalsystems/quint@0.33.0
+          echo "$RUNNER_TEMP/quint/node_modules/.bin" >> "$GITHUB_PATH"
+      - name: Check mutants
+        run: ci/quint/with-server.sh specs/primitives/check.sh --part mutants
+      - name: Check runner contracts
+        run: specs/primitives/check.sh --part contracts
+
+  quint-engine:
+    name: Quint engine conformance
+    runs-on: ubuntu-latest
+    needs: [quint-scenarios, quint-graphs]
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v7
+      - run: echo "QUINT_RUN_DIR=$RUNNER_TEMP/quint-fast" >> "$GITHUB_ENV"
+      - name: Set up pinned Rust
+        id: rust-pin
+        uses: ./ci/toolchain/action
+      - uses: Swatinem/rust-cache@v2
+        with:
+          prefix-key: v1-rust-${{ steps.rust-pin.outputs.version }}
+          add-rust-environment-hash-key: false
+          # Disabling the environment hash also disables rust-cache's lockfile
+          # hash. Include input content in shared-key (which overrides key)
+          # so main can save a fresh immutable cache when inputs change.
+          shared-key: quint-engine-${{ hashFiles('.github/workflows/ci.yml', 'Cargo.lock', 'Cargo.toml', 'crates/*/Cargo.toml', '.cargo/config.toml', 'ci/quint/**', 'specs/primitives/*conformance.sh', 'specs/primitives/check.sh') }}
+          save-if: ${{ github.ref == 'refs/heads/main' }}
+      - uses: actions/download-artifact@v4
+        with:
+          name: quint-scenarios
+          path: ${{ runner.temp }}/quint-fast
+      - uses: actions/download-artifact@v4
+        with:
+          name: quint-graphs
+          path: ${{ runner.temp }}/quint-fast/graphs
+      - name: Check engine conformance and replay
+        run: specs/primitives/check.sh --part engine
+
+  quint-store:
+    name: Quint store conformance
+    runs-on: ubuntu-latest
+    needs: [quint-scenarios, quint-graphs]
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v7
+      - run: echo "QUINT_RUN_DIR=$RUNNER_TEMP/quint-fast" >> "$GITHUB_ENV"
+      - name: Set up pinned Rust
+        id: rust-pin
+        uses: ./ci/toolchain/action
+      - uses: Swatinem/rust-cache@v2
+        with:
+          prefix-key: v1-rust-${{ steps.rust-pin.outputs.version }}
+          add-rust-environment-hash-key: false
+          # Disabling the environment hash also disables rust-cache's lockfile
+          # hash. Include input content in shared-key (which overrides key)
+          # so main can save a fresh immutable cache when inputs change.
+          shared-key: quint-store-${{ hashFiles('.github/workflows/ci.yml', 'Cargo.lock', 'Cargo.toml', 'crates/*/Cargo.toml', '.cargo/config.toml', 'ci/quint/**', 'specs/primitives/*conformance.sh', 'specs/primitives/check.sh') }}
+          save-if: ${{ github.ref == 'refs/heads/main' }}
+      - uses: actions/download-artifact@v4
+        with:
+          name: quint-scenarios
+          path: ${{ runner.temp }}/quint-fast
+      - uses: actions/download-artifact@v4
+        with:
+          name: quint-graphs
+          path: ${{ runner.temp }}/quint-fast/graphs
+      - name: Check store conformance and replay
+        run: specs/primitives/store-conformance.sh "$QUINT_RUN_DIR"
+
+  quint:
+    # Preserve the required-check name. Every selected shard must succeed;
+    # always() also runs this gate when a failed producer skips its consumers.
+    name: Quint quick tier
+    runs-on: ubuntu-latest
+    needs: [changes, stack-scope, quint-scenarios, quint-graphs, quint-mutants, quint-engine, quint-store]
+    if: ${{ always() }}
+    steps:
+      - name: Require every selected Quint part
+        env:
+          SELECTED: ${{ needs.changes.outputs.quint }}
+          FULL: ${{ needs.stack-scope.outputs.full }}
+          RESULTS: ${{ toJSON(needs) }}
+        run: |
+          if [ "$SELECTED" = true ] && [ "$FULL" != false ]; then
+            jq -e '[to_entries[] | select(.key | startswith("quint-")) | .value.result] | length > 0 and all(. == "success")' <<< "$RESULTS"
+          fi
+
   windows-client:
