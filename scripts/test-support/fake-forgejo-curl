#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_CURL_STATUS:?FAKE_CURL_STATUS is required}"
: "${FAKE_CURL_LOG:?FAKE_CURL_LOG is required}"

output=
upload=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output | --upload-file | --write-out | --netrc-file)
      if [[ $# -lt 2 ]]; then
        exit 2
      fi
      case "$1" in
        --output) output=$2 ;;
        --upload-file) upload=$2 ;;
      esac
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [[ -n "$upload" ]]; then
  : "${FAKE_CURL_UPLOADED:?FAKE_CURL_UPLOADED is required for an upload}"
  cp "$upload" "$FAKE_CURL_UPLOADED"
  printf 'upload\n' >>"$FAKE_CURL_LOG"
  exit 0
fi

printf 'get:%s\n' "$FAKE_CURL_STATUS" >>"$FAKE_CURL_LOG"
if [[ "$FAKE_CURL_STATUS" == 200 ]]; then
  : "${FAKE_CURL_REMOTE:?FAKE_CURL_REMOTE is required for a 200 response}"
  cp "$FAKE_CURL_REMOTE" "$output"
fi
printf '%s' "$FAKE_CURL_STATUS"
