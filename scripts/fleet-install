#!/usr/bin/env bash
set -euo pipefail

readonly FLEET_OWNER="${FLEET_INSTALL_OWNER:-lab}"
readonly FLEET_PACKAGE="${FLEET_INSTALL_PACKAGE:-flotilla-fleet}"
readonly FLEET_API_URL="${FLEET_INSTALL_API_URL:-https://forgejo.lab.flotilla.work/api/v1}"
readonly FLEET_PACKAGE_URL="${FLEET_INSTALL_PACKAGE_URL:-https://forgejo.lab.flotilla.work/api/packages}"
readonly FLEET_ROOT="${FLEET_INSTALL_ROOT:-$HOME/.local/opt/flotilla-fleet}"
readonly FLEET_BIN_DIR="${FLEET_INSTALL_BIN_DIR:-$HOME/.local/bin}"
readonly FLEET_TOKEN_FILE="${FLEET_INSTALL_TOKEN_FILE:-$HOME/.config/flotilla/fleet-reader-token}"
readonly SYSTEMD_USER_DIR="${FLEET_INSTALL_SYSTEMD_USER_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
readonly LAUNCH_AGENT_DIR="${FLEET_INSTALL_LAUNCH_AGENT_DIR:-$HOME/Library/LaunchAgents}"
readonly LAUNCH_AGENT_LABEL="work.flotilla.flotillad"
readonly DAEMON_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/flotilla"
readonly DAEMON_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/flotilla"
readonly DAEMON_SOCKET="$DAEMON_CONFIG_DIR/run/flotilla.sock"
readonly LAUNCH_LOG_DIR="$HOME/Library/Logs/flotilla"
readonly RELEASES_DIR="$FLEET_ROOT/releases"
readonly CURRENT_LINK="$FLEET_ROOT/current"
readonly PREVIOUS_LINK="$FLEET_ROOT/previous"
readonly PENDING_CONFIRMATION="$FLEET_ROOT/.pending-confirmation"
readonly TRUSTED_APPLE_TEAM_ID="973L4GV58R"
readonly FLEET_INSTALL_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${FLEET_GENERATION_VALIDATOR:-}" ]]; then
  GENERATION_VALIDATOR="$FLEET_GENERATION_VALIDATOR"
elif [[ -f "$FLEET_INSTALL_SCRIPT_DIR/generation_validation.py" ]]; then
  GENERATION_VALIDATOR="$FLEET_INSTALL_SCRIPT_DIR/generation_validation.py"
else
  GENERATION_VALIDATOR="$FLEET_INSTALL_SCRIPT_DIR/../ci/fleet-candidates/generation_validation.py"
fi
readonly GENERATION_VALIDATOR
readonly CONFIRM_TIMEOUT_SECONDS="${FLEET_INSTALL_CONFIRM_TIMEOUT_SECONDS:-30}"
PLATFORM=""
AUTH_HEADER_FILE=""
WORK_DIR=""
READ_ONLY=0
INSTALL_LOCK_PATH=""
INSTALL_LOCK_OWNER=""
INSTALL_LOCK_HELD=0
DARWIN_AGENT_DISABLED=0
CONFIRMATION_PID=""
CONFIRMATION_LOG=""
CONFIRMATION_DONE=""
readonly GENERATION_INCOMPLETE_EXIT=20

die() {
  printf 'fleet-install: %s\n' "$*" >&2
  exit 1
}

cleanup() {
  [[ -z "$WORK_DIR" ]] || rm -rf -- "$WORK_DIR"
  if ((INSTALL_LOCK_HELD)); then
    python3 - "$INSTALL_LOCK_PATH" "$INSTALL_LOCK_OWNER" <<'PY'
import os
import sys

path, owner = sys.argv[1:]
try:
    if os.path.islink(path) and os.readlink(path) == owner:
        os.unlink(path)
except FileNotFoundError:
    pass
PY
  fi
  [[ -z "$CONFIRMATION_DONE" ]] || touch -- "$CONFIRMATION_DONE"
}
trap cleanup EXIT

host_platform() {
  local system="${FLEET_INSTALL_UNAME_S:-$(uname -s)}"
  local machine="${FLEET_INSTALL_UNAME_M:-$(uname -m)}"
  case "$system-$machine" in
    Linux-x86_64) printf 'linux-x86_64-gnu2.36\n' ;;
    Darwin-arm64) printf 'darwin-aarch64\n' ;;
    *) die "unsupported platform: $system-$machine" ;;
  esac
}

require_generation() {
  local generation="$1"
  [[ "$generation" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die "invalid generation id: $generation"
}

make_work_dir() {
  [[ -n "$WORK_DIR" ]] && return
  if ((READ_ONLY)); then
    WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/fleet-install.XXXXXX")"
  else
    mkdir -p "$FLEET_ROOT"
    WORK_DIR="$(mktemp -d "$FLEET_ROOT/.fleet-install.XXXXXX")"
  fi
}

acquire_install_lock() {
  mkdir -p "$FLEET_ROOT"
  INSTALL_LOCK_PATH="$FLEET_ROOT/.install.lock"
  INSTALL_LOCK_OWNER="$$-$(python3 - <<'PY'
import secrets

print(secrets.token_hex(8))
PY
)"
  if ! ln -s "$INSTALL_LOCK_OWNER" "$INSTALL_LOCK_PATH" 2>/dev/null; then
    local owner pid
    owner="$(readlink "$INSTALL_LOCK_PATH" 2>/dev/null)" \
      || die "fleet-install lock is malformed; inspect and remove it if safe: $INSTALL_LOCK_PATH"
    pid="${owner%%-*}"
    [[ "$pid" =~ ^[0-9]+$ ]] \
      || die "fleet-install lock has an invalid owner; inspect and remove it if safe: $INSTALL_LOCK_PATH"
    if kill -0 "$pid" 2>/dev/null; then
      die "another fleet-install mutation is already running (pid $pid)"
    fi
    python3 - "$INSTALL_LOCK_PATH" "$owner" <<'PY'
import os
import sys

path, stale_owner = sys.argv[1:]
try:
    if os.path.islink(path) and os.readlink(path) == stale_owner:
        os.unlink(path)
except FileNotFoundError:
    pass
PY
    ln -s "$INSTALL_LOCK_OWNER" "$INSTALL_LOCK_PATH" 2>/dev/null \
      || die "another fleet-install mutation acquired the lock while reclaiming a stale owner"
  fi
  INSTALL_LOCK_HELD=1
}

prepare_auth() {
  [[ -n "$AUTH_HEADER_FILE" ]] && return
  [[ -f "$FLEET_TOKEN_FILE" && ! -L "$FLEET_TOKEN_FILE" ]] || die "package token is missing: $FLEET_TOKEN_FILE"
  local mode
  mode="$(python3 - "$FLEET_TOKEN_FILE" <<'PY'
import os
import stat
import sys

print(format(stat.S_IMODE(os.stat(sys.argv[1]).st_mode), "o"))
PY
)"
  [[ "$mode" == 600 ]] || die "package token must have mode 0600: $FLEET_TOKEN_FILE (has $mode)"
  make_work_dir
  AUTH_HEADER_FILE="$WORK_DIR/authorization.header"
  local token
  token="$(<"$FLEET_TOKEN_FILE")"
  [[ -n "$token" && ! "$token" =~ [[:space:]] ]] \
    || die "package token is empty or malformed: $FLEET_TOKEN_FILE"
  (umask 077 && printf 'Authorization: token %s\n' "$token" >"$AUTH_HEADER_FILE")
}

download() {
  local url="$1"
  local destination="$2"
  prepare_auth
  # Never forward the package credential through an HTTP redirect.
  curl --fail --silent --show-error --header "@$AUTH_HEADER_FILE" --output "$destination" "$url"
}

download_generation_manifest() {
  local url="$1"
  local destination="$2"
  prepare_auth
  local http_status rc
  if http_status="$(
    curl --silent --show-error --header "@$AUTH_HEADER_FILE" --output "$destination" \
      --write-out '%{http_code}' "$url"
  )"; then
    case "$http_status" in
      200) return 0 ;;
      404) return "$GENERATION_INCOMPLETE_EXIT" ;;
      *) die "generation manifest request returned HTTP $http_status" ;;
    esac
  else
    rc=$?
  fi
  return "$rc"
}

latest_generation() {
  make_work_dir
  local page=1
  local all="$WORK_DIR/packages.jsonl"
  : >"$all"
  while true; do
    local response="$WORK_DIR/packages-$page.json"
    download "$FLEET_API_URL/packages/$FLEET_OWNER?type=generic&q=$FLEET_PACKAGE&limit=100&page=$page" "$response"
    local count
    count="$(python3 - "$response" "$FLEET_PACKAGE" "$all" <<'PY'
import json
import sys

packages = json.load(open(sys.argv[1]))
if not isinstance(packages, list):
    raise SystemExit("package listing is not an array")
with open(sys.argv[3], "a") as output:
    for package in packages:
        if package.get("type") == "generic" and package.get("name") == sys.argv[2]:
            print(json.dumps([package.get("created_at", ""), package.get("version", "")]), file=output)
print(len(packages))
PY
)"
    [[ "$count" =~ ^[0-9]+$ ]] || die 'invalid package listing response'
    (( count == 100 )) || break
    ((page += 1))
  done
  local candidate index=0
  while IFS= read -r candidate; do
    index=$((index + 1))
    local result
    if fetch_generation_manifest "$candidate" "$WORK_DIR/latest-$index-generation.json"; then
      printf '%s\n' "$candidate"
      return 0
    else
      result=$?
    fi
    if ((result == GENERATION_INCOMPLETE_EXIT)); then
      printf 'fleet-install: skipping incomplete %s generation %s\n' "$PLATFORM" "$candidate" >&2
      continue
    fi
    die "could not verify advertised generation $candidate"
  done < <(python3 - "$all" <<'PY'
import json
import sys

rows = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
rows = [row for row in rows if row[0] and row[1]]
for row in sorted(rows, reverse=True):
    print(row[1])
PY
)
  die "Forgejo has no completed $PLATFORM flotilla-fleet generations"
}

fetch_generation_manifest() {
  local generation="$1"
  local destination="$2"
  require_generation "$generation"
  local result
  download_generation_manifest \
    "$FLEET_PACKAGE_URL/$FLEET_OWNER/generic/$FLEET_PACKAGE/$generation/generation.json" "$destination" \
    || {
      result=$?
      return "$result"
    }
  python3 "$GENERATION_VALIDATOR" generation "$destination" "$generation" "$PLATFORM" --installable
}

require_generation_manifest() {
  local generation="$1"
  local destination="$2"
  local result
  if fetch_generation_manifest "$generation" "$destination"; then
    return 0
  else
    result=$?
  fi
  if ((result == GENERATION_INCOMPLETE_EXIT)); then
    die "generation $generation is not complete for $PLATFORM"
  fi
  die "could not fetch requested generation $generation"
}

manifest_value() {
  local manifest="$1"
  local expression="$2"
  python3 - "$manifest" "$expression" <<'PY'
import json
import sys

value = json.load(open(sys.argv[1]))
for part in sys.argv[2].split("."):
    value = value[part]
print(value)
PY
}

platform_value() {
  local manifest="$1"
  local field="$2"
  python3 - "$manifest" "$PLATFORM" "$field" <<'PY'
import json
import sys

print(json.load(open(sys.argv[1]))["platforms"][sys.argv[2]][sys.argv[3]])
PY
}

sha256_file() {
  python3 - "$1" <<'PY'
import hashlib
import sys

digest = hashlib.sha256()
with open(sys.argv[1], "rb") as source:
    for block in iter(lambda: source.read(1024 * 1024), b""):
        digest.update(block)
print(digest.hexdigest())
PY
}

file_size() {
  python3 - "$1" <<'PY'
import os
import sys

print(os.path.getsize(sys.argv[1]))
PY
}

extract_and_verify() {
  local archive="$1"
  local destination="$2"
  local generation_manifest="$3"
  python3 - "$archive" "$destination" "$PLATFORM" <<'PY'
import shutil
import sys
import tarfile
from pathlib import Path, PurePosixPath

archive = Path(sys.argv[1])
destination = Path(sys.argv[2])
platform = sys.argv[3]
expected_root = "fleet-signed-darwin-aarch64" if platform == "darwin-aarch64" else f"fleet-candidate-{platform}"
with tarfile.open(archive, "r:gz") as bundle:
    members = bundle.getmembers()
    names = set()
    roots = set()
    for member in members:
        path = PurePosixPath(member.name)
        normalized = str(path)
        if path.is_absolute() or ".." in path.parts or not path.parts or normalized in names:
            raise SystemExit(f"unsafe or duplicate archive path: {member.name}")
        if not (member.isfile() or member.isdir()):
            raise SystemExit(f"unsupported archive entry: {member.name}")
        names.add(normalized)
        roots.add(path.parts[0])
    if roots != {expected_root}:
        raise SystemExit(f"archive has an unexpected bundle directory: expected {expected_root}, got {sorted(roots)}")
    for member in members:
        target = destination.joinpath(*PurePosixPath(member.name).parts)
        if member.isdir():
            target.mkdir(parents=True, exist_ok=True)
            target.chmod(member.mode & 0o777)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        source = bundle.extractfile(member)
        if source is None:
            raise SystemExit(f"archive entry cannot be read: {member.name}")
        with source, target.open("wb") as output:
            shutil.copyfileobj(source, output)
        target.chmod(member.mode & 0o777)
shutil.move(str(destination / expected_root), str(destination / "release"))
PY
  verify_release "$destination/release" "$generation_manifest"
  cp "$generation_manifest" "$destination/release/.generation.json"
}

verify_release() {
  local release="$1"
  local generation_manifest="$2"
  python3 "$GENERATION_VALIDATOR" release "$release" "$generation_manifest" "$PLATFORM"
  if [[ "$PLATFORM" == darwin-aarch64 ]]; then
    verify_darwin_signatures "$release" "$generation_manifest"
  fi
}

verify_installed_release() {
  verify_release "$1" "$2"
}

codesign_program() {
  if [[ "${FLEET_INSTALL_TESTING:-0}" == 1 && -n "${FLEET_INSTALL_TEST_CODESIGN:-}" ]]; then
    printf '%s\n' "$FLEET_INSTALL_TEST_CODESIGN"
  else
    printf '/usr/bin/codesign\n'
  fi
}

verify_darwin_signatures() {
  local release="$1"
  local generation_manifest="$2"
  local identity requirement codesign
  identity="$(manifest_value "$generation_manifest" central_signing.signing.identity)"
  requirement="=designated => anchor apple generic and certificate leaf[subject.OU] = \"$TRUSTED_APPLE_TEAM_ID\""
  codesign="$(codesign_program)"
  local targets=("$release"/lib/*.dylib "$release"/bin/flotilla "$release"/bin/flotillad "$release"/bin/cleat)
  local path relative verification details entitlements
  for path in "${targets[@]}"; do
    [[ -f "$path" ]] || continue
    relative="${path#"$release"/}"
    verification="$WORK_DIR/codesign-verify-${relative//\//-}"
    "$codesign" --verify --strict --verbose=2 --requirements "$requirement" "$path" \
      >"$verification" 2>&1 \
      || die "strict signature verification failed: $relative"
    details="$WORK_DIR/codesign-details-${relative//\//-}"
    "$codesign" -d --verbose=4 "$path" >"$details" 2>&1 \
      || die "signature inspection failed: $relative"
    grep -Fxq "Authority=$identity" "$details" \
      || die "signed Darwin payload has an unexpected authority: $relative"
    grep -Fxq "TeamIdentifier=$TRUSTED_APPLE_TEAM_ID" "$details" \
      || die "signed Darwin payload has an unexpected team: $relative"
    entitlements="$WORK_DIR/codesign-entitlements-${relative//\//-}.plist"
    "$codesign" --display --entitlements - --xml "$path" >"$entitlements" 2>/dev/null \
      || die "entitlements inspection failed: $relative"
    python3 - "$entitlements" "$relative" <<'PY'
import plistlib
import sys

content = open(sys.argv[1], "rb").read()
try:
    entitlements = plistlib.loads(content) if content.strip() else {}
except plistlib.InvalidFileException as error:
    raise SystemExit(f"signed Darwin payload has unreadable entitlements: {sys.argv[2]}: {error}")
if entitlements != {}:
    raise SystemExit(f"signed Darwin payload has unexpected entitlements: {sys.argv[2]}")
PY
  done
}

current_generation() {
  [[ -L "$CURRENT_LINK" ]] || return 0
  local target
  target="$(readlink "$CURRENT_LINK")"
  [[ "$target" =~ ^releases/[^/]+$ ]] || die "current has an unsafe target: $target"
  printf '%s\n' "${target#releases/}"
}

protocol_version() {
  local link="$1"
  [[ -f "$link/manifest.json" ]] || return 0
  python3 - "$link/manifest.json" <<'PY'
import json
import sys
try:
    print(json.load(open(sys.argv[1])).get("peer_protocol_version", ""))
except (OSError, ValueError):
    pass
PY
}

show_fleet_spread() {
  if ! pgrep -u "$(id -u)" -x flotillad >/dev/null 2>&1; then
    printf 'fleet:   unavailable (daemon not running)\n'
    return
  fi
  if [[ ! -x "$CURRENT_LINK/bin/flotilla" ]]; then
    printf 'fleet:   unavailable (no current fleet CLI)\n'
    return
  fi

  local response="$WORK_DIR/fleet-health.json"
  if ! FLOTILLA_CONTAINED_HOST_DAEMON=1 "$CURRENT_LINK/bin/flotilla" --json host list >"$response" 2>/dev/null; then
    printf 'fleet:   unavailable (daemon query failed)\n'
    return
  fi
  if ! python3 - "$response" <<'PY'
import json
import sys

try:
    response = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    raise SystemExit(1)
if not isinstance(response, dict) or response.get("kind") != "fleet_health":
    raise SystemExit(1)
hosts = response.get("hosts")
if not isinstance(hosts, list):
    raise SystemExit(1)

spread = {}
for host in hosts:
    if not isinstance(host, dict) or not isinstance(host.get("host"), str):
        raise SystemExit(1)
    generation = host.get("daemon_generation")
    if not isinstance(generation, str) or not generation:
        generation = "unknown"
    name = host["host"] + (" (local)" if host.get("is_local") is True else "")
    spread.setdefault(generation, []).append(name)

print("fleet wire generations:")
for generation in sorted(spread, key=lambda value: (value == "unknown", value)):
    print(f"  {generation}: {', '.join(sorted(spread[generation]))}")
PY
  then
    printf 'fleet:   unavailable (invalid daemon response)\n'
  fi
}

write_launcher() {
  local name="$1"
  local launcher="$FLEET_BIN_DIR/$name"
  mkdir -p "$FLEET_BIN_DIR"
  if [[ -e "$launcher" ]] && ! grep -Fq '# managed by fleet-install' "$launcher" 2>/dev/null; then
    die "refusing to replace unmanaged launcher: $launcher"
  fi
  local temporary
  temporary="$(mktemp "$FLEET_BIN_DIR/.$name.fleet-install.XXXXXX")"
  printf '#!/usr/bin/env bash\n# managed by fleet-install\nexec %q/current/bin/%q "$@"\n' "$FLEET_ROOT" "$name" >"$temporary"
  chmod 0755 "$temporary"
  mv -f "$temporary" "$launcher"
}

ensure_launchers_and_path() {
  local name
  for name in flotilla flotillad cleat; do
    write_launcher "$name"
  done

  local login_shell="${SHELL:-/bin/sh}"
  local init_file
  case "${login_shell##*/}" in
    zsh) init_file='~/.zshenv' ;;
    fish) init_file='~/.config/fish/config.fish' ;;
    *) init_file='~/.profile' ;;
  esac

  local resolved expected
  for name in flotilla flotillad cleat; do
    resolved="$( (unset PATH; "$login_shell" -l -c "command -v $name") 2>/dev/null || true)"
    [[ -n "$resolved" ]] \
      || die "$name is not reachable through the login shell; add $FLEET_BIN_DIR to PATH in $init_file before installing"
    expected="$(python3 - "$FLEET_BIN_DIR/$name" <<'PY'
import os
import sys

print(os.path.realpath(sys.argv[1]))
PY
)"
    resolved="$(python3 - "$resolved" <<'PY'
import os
import sys

print(os.path.realpath(sys.argv[1]))
PY
)"
    [[ "$resolved" == "$expected" ]] \
      || die "the login shell PATH shadows the fleet launcher for $name: $resolved; put $FLEET_BIN_DIR first in $init_file"
  done
}

write_systemd_user_unit() {
  [[ "$PLATFORM" == linux-* ]] || return 0
  local unit="$SYSTEMD_USER_DIR/flotillad.service"
  local temporary daemon_path fleet_bin_path cargo_bin_path skills_path
  daemon_path="$(systemd_path "$FLEET_ROOT/current/bin/flotillad")"
  fleet_bin_path="$(systemd_path "$FLEET_BIN_DIR")"
  cargo_bin_path="$(systemd_path "$HOME/.cargo/bin")"
  skills_path="$(systemd_path "$FLEET_ROOT/current/share/flotilla/skills")"
  mkdir -p "$SYSTEMD_USER_DIR"
  temporary="$(mktemp "$SYSTEMD_USER_DIR/.flotillad.service.fleet-install.XXXXXX")"
  cat >"$temporary" <<UNIT
# managed by fleet-install
[Unit]
Description=Flotilla daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="$daemon_path"
Environment="PATH=$fleet_bin_path:$cargo_bin_path:/usr/local/bin:/usr/bin:/bin"
Environment="FLOTILLA_SKILLS_DIR=$skills_path"
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
  chmod 0644 "$temporary"
  mv -f "$temporary" "$unit"
}

systemd_path() {
  python3 - "$1" "$HOME" <<'PY'
import os
import sys

path, home = sys.argv[1:]
if "\n" in path or "\r" in path:
    raise SystemExit("systemd path contains a line break")
if path == home:
    print("%h")
elif path.startswith(home + os.sep):
    relative = path[len(home) + 1 :].replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")
    print(f"%h/{relative}")
else:
    print(path.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%"))
PY
}

prepare_linux_daemon_service() {
  [[ "$PLATFORM" == linux-* ]] || return 0
  command -v loginctl >/dev/null || die 'cannot install flotillad.service: loginctl is not available'
  command -v systemctl >/dev/null || die 'cannot install flotillad.service: systemctl is not available'
  write_systemd_user_unit
  # Re-enabling linger can be denied by polkit outside a login session even
  # when linger is already on; only attempt the transition that is needed.
  local user
  user="$(id -un)"
  if [[ "$(loginctl show-user "$user" --property Linger --value 2>/dev/null)" != yes ]]; then
    loginctl enable-linger "$user" || true
    [[ "$(loginctl show-user "$user" --property Linger --value 2>/dev/null)" == yes ]] \
      || die "cannot enable linger for $user; run: sudo loginctl enable-linger $user"
  fi
  systemctl --user daemon-reload
  systemctl --user enable flotillad.service
}

restart_linux_daemon_service() {
  [[ "$PLATFORM" == linux-* ]] || return 0
  command -v systemctl >/dev/null || die 'cannot restart flotillad.service: systemctl is not available'
  systemctl --user restart flotillad.service
}

write_launchd_agent() {
  [[ "$PLATFORM" == darwin-* ]] || return 0
  local plist="$LAUNCH_AGENT_DIR/$LAUNCH_AGENT_LABEL.plist"
  local temporary daemon_path daemon_path_value skills_path stderr_path stdout_path
  daemon_path="$FLEET_ROOT/current/bin/flotillad"
  daemon_path_value="$FLEET_BIN_DIR:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  skills_path="$FLEET_ROOT/current/share/flotilla/skills"
  stderr_path="$LAUNCH_LOG_DIR/flotillad.stderr.log"
  stdout_path="$LAUNCH_LOG_DIR/flotillad.stdout.log"
  mkdir -p "$LAUNCH_AGENT_DIR" "$LAUNCH_LOG_DIR"
  temporary="$(mktemp "$LAUNCH_AGENT_DIR/.$LAUNCH_AGENT_LABEL.plist.fleet-install.XXXXXX")"
  python3 - "$temporary" "$LAUNCH_AGENT_LABEL" "$daemon_path" "$daemon_path_value" "$skills_path" \
    "$DAEMON_CONFIG_DIR" "$DAEMON_STATE_DIR" "$DAEMON_SOCKET" "$stderr_path" "$stdout_path" <<'PY'
import plistlib
import sys

destination, label, daemon, path, skills, config_dir, state_dir, socket, stderr_path, stdout_path = sys.argv[1:]
content = {
    "Label": label,
    "ProgramArguments": [
        daemon,
        "--config-dir",
        config_dir,
        "--state-dir",
        state_dir,
        "--socket",
        socket,
    ],
    "EnvironmentVariables": {"PATH": path, "FLOTILLA_SKILLS_DIR": skills},
    "StandardErrorPath": stderr_path,
    "StandardOutPath": stdout_path,
    "RunAtLoad": True,
    "KeepAlive": {"SuccessfulExit": False},
}
with open(destination, "wb") as output:
    plistlib.dump(content, output, sort_keys=False)
PY
  chmod 0644 "$temporary"
  mv -f "$temporary" "$plist"
}

prepare_darwin_daemon_service() {
  [[ "$PLATFORM" == darwin-* ]] || return 0
  command -v launchctl >/dev/null || die "cannot install $LAUNCH_AGENT_LABEL: launchctl is not available"
  local domain="gui/$(id -u)"
  local disabled_services
  disabled_services="$(launchctl print-disabled "$domain")" \
    || die "cannot determine whether $LAUNCH_AGENT_LABEL is disabled"
  if grep -Fq "\"$LAUNCH_AGENT_LABEL\" => true" <<<"$disabled_services"; then
    DARWIN_AGENT_DISABLED=1
  fi
  # Unload before publishing the refreshed plist. Enabled clients then defer
  # to launchd, whose kickstart cannot race the generation flip while the job
  # is absent from the domain.
  launchctl bootout "$domain/$LAUNCH_AGENT_LABEL" >/dev/null 2>&1 || true
  write_launchd_agent
}

restart_darwin_daemon_service() {
  [[ "$PLATFORM" == darwin-* ]] || return 0
  if ((DARWIN_AGENT_DISABLED)); then
    printf 'fleet-install: preserving flotillad dev mode; launchd agent remains disabled\n'
    return 0
  fi
  command -v launchctl >/dev/null || die "cannot restart $LAUNCH_AGENT_LABEL: launchctl is not available"
  local domain="gui/$(id -u)"
  local target="$domain/$LAUNCH_AGENT_LABEL"
  local plist="$LAUNCH_AGENT_DIR/$LAUNCH_AGENT_LABEL.plist"
  launchctl enable "$target"
  launchctl bootstrap "$domain" "$plist"
  launchctl kickstart -k "$target"
}

probe_daemon_health() {
  local response="$WORK_DIR/daemon-health.json"
  # This candidate CLI's socket hello requires an exact build and protocol
  # fingerprint match. A successful fleet query therefore proves both that
  # the selected daemon answered and that its control plane is ready.
  if ! FLOTILLA_CONTAINED_HOST_DAEMON=1 "$CURRENT_LINK/bin/flotilla" --json fleet >"$response" 2>/dev/null; then
    return 1
  fi
  python3 - "$response" <<'PY'
import json
import sys

try:
    response = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    raise SystemExit(1)
if not isinstance(response, dict) or response.get("kind") != "fleet_health":
    raise SystemExit(1)
hosts = response.get("hosts")
if not isinstance(hosts, list):
    raise SystemExit(1)
if not any(isinstance(host, dict) and host.get("is_local") is True for host in hosts):
    raise SystemExit(1)
PY
}

wait_for_daemon_generation() {
  local generation="$1"
  [[ "$CONFIRM_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] \
    || die "health confirmation timeout must be a non-negative integer: $CONFIRM_TIMEOUT_SECONDS"
  local deadline=$((SECONDS + CONFIRM_TIMEOUT_SECONDS))
  while true; do
    if [[ "$(current_generation)" == "$generation" ]] && probe_daemon_health; then
      return 0
    fi
    ((SECONDS < deadline)) || return 1
    sleep 1
  done
}

arm_health_confirmation() {
  local generation="$1"
  local rollback_generation="$2"
  local token="$3"
  local temporary="$FLEET_ROOT/.pending-confirmation.new.$$"
  printf 'candidate=%s\nrollback=%s\ntoken=%s\n' "$generation" "$rollback_generation" "$token" >"$temporary"
  mv -f "$temporary" "$PENDING_CONFIRMATION"
}

confirmation_is_armed() {
  local token="$1"
  [[ -f "$PENDING_CONFIRMATION" ]] && grep -Fxq "token=$token" "$PENDING_CONFIRMATION"
}

disarm_health_confirmation() {
  local token="$1"
  python3 - "$PENDING_CONFIRMATION" "$token" <<'PY'
import os
import sys

path, token = sys.argv[1:]
try:
    with open(path) as source:
        armed = any(line.rstrip("\n") == f"token={token}" for line in source)
    if armed:
        os.unlink(path)
except FileNotFoundError:
    pass
PY
}

automatic_rollback() {
  local failed_generation="$1"
  local rollback_generation="$2"
  [[ -n "$rollback_generation" ]] || return 1
  [[ -d "$RELEASES_DIR/$rollback_generation" ]] || return 1
  [[ -f "$RELEASES_DIR/$rollback_generation/.generation.json" ]] || return 1
  verify_installed_release "$RELEASES_DIR/$rollback_generation" "$RELEASES_DIR/$rollback_generation/.generation.json" || return 1
  # launchd must unload the candidate before the symlink flip. systemd has no
  # equivalent race and its stable unit was already refreshed by the parent.
  prepare_darwin_daemon_service || return 1
  atomic_link "releases/$rollback_generation" "$CURRENT_LINK" || return 1
  atomic_link "releases/$failed_generation" "$PREVIOUS_LINK" || return 1
  restart_linux_daemon_service || return 1
  restart_darwin_daemon_service || return 1
  wait_for_daemon_generation "$rollback_generation" || return 1
}

confirmation_watchdog() {
  local generation="$1"
  local rollback_generation="$2"
  local token="$3"
  make_work_dir
  local activation_deadline=$((SECONDS + 10))
  while [[ "$(current_generation)" != "$generation" ]]; do
    confirmation_is_armed "$token" || return 0
    if ((SECONDS >= activation_deadline)); then
      disarm_health_confirmation "$token"
      return 0
    fi
    sleep 0.1
  done
  if wait_for_daemon_generation "$generation"; then
    disarm_health_confirmation "$token"
    printf 'fleet-install: generation %s confirmed healthy\n' "$generation"
    return 0
  fi
  confirmation_is_armed "$token" || return 0
  local parent_pid="${token%%-*}"
  if ! kill -0 "$parent_pid" 2>/dev/null; then
    # The foreground installer normally holds this lock for the watchdog's
    # lifetime. If it died, reclaim that protection before mutating links so
    # a replacement install cannot race the orphaned rollback.
    acquire_install_lock
    confirmation_is_armed "$token" || return 0
  fi
  if automatic_rollback "$generation" "$rollback_generation"; then
    disarm_health_confirmation "$token"
    printf 'fleet-install: generation %s failed health confirmation; rolled back to %s\n' "$generation" "$rollback_generation" >&2
    return 10
  fi
  printf 'fleet-install: generation %s failed health confirmation and no healthy previous generation could be restored\n' "$generation" >&2
  return 1
}

start_confirmation_watchdog() {
  local generation="$1"
  local rollback_generation="$2"
  local token="$3"
  local installer
  installer="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  # A detached watchdog keeps its log as an audit trail if the foreground
  # installer dies. Prune only logs whose watchdog marked them complete.
  local completed_log
  for completed_log in "$FLEET_ROOT"/.confirmation.*.log.done; do
    [[ -f "$completed_log" ]] || continue
    rm -f -- "${completed_log%.done}" "$completed_log"
  done
  CONFIRMATION_LOG="$FLEET_ROOT/.confirmation.$token.log"
  nohup "$installer" __confirm "$generation" "$rollback_generation" "$token" >"$CONFIRMATION_LOG" 2>&1 </dev/null &
  CONFIRMATION_PID=$!
}

await_confirmation_watchdog() {
  local generation="$1"
  local rollback_generation="$2"
  local result
  if wait "$CONFIRMATION_PID"; then
    result=0
  else
    result=$?
  fi
  [[ ! -f "$CONFIRMATION_LOG" ]] || cat "$CONFIRMATION_LOG"
  rm -f -- "$CONFIRMATION_LOG" "$CONFIRMATION_LOG.done"
  CONFIRMATION_LOG=""
  case "$result" in
    0) return 0 ;;
    10) die "generation $generation failed health confirmation; rolled back to $rollback_generation" ;;
    *) die "generation $generation failed health confirmation and no healthy previous generation could be restored" ;;
  esac
}

daemon_preflight() {
  local generation="$1"
  pgrep -u "$(id -u)" -x flotillad >/dev/null 2>&1 || return 0
  local cli invocation
  if [[ -x "$CURRENT_LINK/bin/flotilla" ]]; then
    cli="$CURRENT_LINK/bin/flotilla"
  elif [[ -x "$RELEASES_DIR/$generation/bin/flotilla" ]]; then
    cli="$RELEASES_DIR/$generation/bin/flotilla"
  else
    cli="$(command -v flotilla || true)"
  fi
  [[ -n "$cli" ]] || die 'flotillad is running; install a usable flotilla command and run `flotilla daemon stop`'
  if ! "$cli" daemon stop; then
    printf -v invocation '%q daemon stop' "$cli"
    die "flotillad is running and could not be stopped; run \`$invocation\`, then retry"
  fi
}

atomic_link() {
  local target="$1"
  local link="$2"
  local temporary
  temporary="$FLEET_ROOT/.$(basename "$link").new.$$"
  ln -s "$target" "$temporary"
  python3 - "$temporary" "$link" <<'PY'
import os
import sys

os.replace(sys.argv[1], sys.argv[2])
PY
}

switch_to() {
  local generation="$1"
  local rollback_generation="$2"
  local confirmation_token="$3"
  local old
  old="$(current_generation)"
  if [[ "$old" == "$generation" ]]; then
    arm_health_confirmation "$generation" "$rollback_generation" "$confirmation_token"
    if ((!DARWIN_AGENT_DISABLED)); then
      start_confirmation_watchdog "$generation" "$rollback_generation" "$confirmation_token"
    fi
    return 0
  fi
  daemon_preflight "$generation"
  arm_health_confirmation "$generation" "$rollback_generation" "$confirmation_token"
  if ((!DARWIN_AGENT_DISABLED)); then
    start_confirmation_watchdog "$generation" "$rollback_generation" "$confirmation_token"
  fi
  if [[ -n "$old" ]]; then
    atomic_link "releases/$old" "$PREVIOUS_LINK"
  fi
  atomic_link "releases/$generation" "$CURRENT_LINK"
}

activate_staged_generation() {
  local generation="$1"
  local rollback_generation="$2"
  local confirmation_token="$3"
  local release="$RELEASES_DIR/$generation"
  make_work_dir
  [[ -d "$release" ]] || die "staged generation is missing: $generation"
  [[ -f "$release/.generation.json" ]] || die "staged generation has no verified generation metadata: $generation"
  verify_installed_release "$release" "$release/.generation.json"
  # Verification is the only activation step that needs this process's work
  # directory. Release it before service mutation so interruption cannot leak
  # staging state while the detached health watchdog completes recovery.
  [[ -z "$WORK_DIR" ]] || rm -rf -- "$WORK_DIR"
  WORK_DIR=""
  ensure_launchers_and_path
  prepare_linux_daemon_service
  prepare_darwin_daemon_service
  switch_to "$generation" "$rollback_generation" "$confirmation_token"
  restart_linux_daemon_service
  restart_darwin_daemon_service
  if ((DARWIN_AGENT_DISABLED)); then
    disarm_health_confirmation "$confirmation_token"
    printf 'fleet-install: health confirmation skipped while flotillad dev mode is active\n'
  else
    await_confirmation_watchdog "$generation" "$rollback_generation"
  fi
}

handoff_activation() {
  local generation="$1"
  local rollback_generation="$2"
  local confirmation_token="$3"
  local incoming_installer="$RELEASES_DIR/$generation/install.sh"
  [[ -x "$incoming_installer" ]] || die "verified generation has no executable installer: $generation"
  printf 'fleet-install: handing off activation to generation %s installer\n' "$generation"
  # exec does not run this process's EXIT trap. Discard the bootstrap
  # verifier's downloads before replacing it with the incoming installer.
  [[ -z "$WORK_DIR" ]] || rm -rf -- "$WORK_DIR"
  WORK_DIR=""
  exec "$incoming_installer" __activate "$generation" "$rollback_generation" "$confirmation_token" "$INSTALL_LOCK_OWNER"
}

require_handoff_lock() {
  local expected_owner="$1"
  local lock="$FLEET_ROOT/.install.lock"
  [[ -L "$lock" && "$(readlink "$lock")" == "$expected_owner" ]] \
    || die 'installer activation handoff does not own the fleet-install mutation lock'
}

install_generation() {
  local generation="$1"
  require_generation "$generation"
  acquire_install_lock
  mkdir -p "$RELEASES_DIR"
  local old rollback_generation confirmation_token
  old="$(current_generation)"
  rollback_generation="$old"
  if [[ "$old" == "$generation" && -L "$PREVIOUS_LINK" ]]; then
    local previous_target
    previous_target="$(readlink "$PREVIOUS_LINK")"
    if [[ "$previous_target" =~ ^releases/[^/]+$ ]]; then
      rollback_generation="${previous_target#releases/}"
    fi
  fi
  [[ "$rollback_generation" != "$generation" ]] || rollback_generation=""
  confirmation_token="$$-$(python3 - <<'PY'
import secrets

print(secrets.token_hex(8))
PY
)"
  printf 'fleet-install: %s -> %s\n' "${old:-<none>}" "$generation"
  if [[ -d "$RELEASES_DIR/$generation" ]]; then
    make_work_dir
    local installed_outer="$WORK_DIR/installed-generation.json"
    require_generation_manifest "$generation" "$installed_outer"
    verify_installed_release "$RELEASES_DIR/$generation" "$installed_outer"
    if [[ -n "$old" ]]; then
      handoff_activation "$generation" "$rollback_generation" "$confirmation_token"
    else
      # Fresh installs have no trusted installed generation to hand off from;
      # the bootstrap installer completes their first activation itself.
      activate_staged_generation "$generation" "$rollback_generation" "$confirmation_token"
    fi
    printf 'fleet-install: generation %s is installed\n' "$generation"
    return
  fi
  make_work_dir
  local outer="$WORK_DIR/generation.json"
  local archive="$WORK_DIR/artifact.tar.gz"
  local unpack="$WORK_DIR/unpack"
  require_generation_manifest "$generation" "$outer"
  local artifact expected expected_size actual actual_size
  artifact="$(platform_value "$outer" artifact)"
  expected="$(platform_value "$outer" sha256)"
  expected_size="$(platform_value "$outer" size_bytes)"
  download "$FLEET_PACKAGE_URL/$FLEET_OWNER/generic/$FLEET_PACKAGE/$generation/$artifact" "$archive"
  actual="$(sha256_file "$archive")"
  actual_size="$(file_size "$archive")"
  [[ "$actual_size" == "$expected_size" ]] \
    || die "archive size mismatch for $generation: expected $expected_size, got $actual_size"
  [[ "$actual" == "$expected" ]] || die "archive digest mismatch for $generation: expected $expected, got $actual"
  mkdir -p "$unpack"
  extract_and_verify "$archive" "$unpack" "$outer"
  mv "$unpack/release" "$RELEASES_DIR/$generation"
  chmod -R a-w "$RELEASES_DIR/$generation"
  if [[ -n "$old" ]]; then
    handoff_activation "$generation" "$rollback_generation" "$confirmation_token"
  else
    # The bootstrap installer owns the fresh-install path; subsequent
    # generations adopt their own installer through handoff_activation.
    activate_staged_generation "$generation" "$rollback_generation" "$confirmation_token"
  fi
  printf 'fleet-install: generation %s is installed\n' "$generation"
}

show_status() {
  make_work_dir
  local current latest target_manifest current_version target_version
  current="$(current_generation)"
  latest="$(latest_generation)"
  target_manifest="$WORK_DIR/latest-manifest.json"
  require_generation_manifest "$latest" "$target_manifest"
  current_version="$(protocol_version "$CURRENT_LINK")"
  target_version="$(manifest_value "$target_manifest" peer_protocol_version)"
  printf 'current: %s (peer protocol %s)\n' "${current:-<none>}" "${current_version:-unknown}"
  printf 'latest:  %s (peer protocol %s)\n' "$latest" "$target_version"
  show_fleet_spread
  if [[ -n "$current_version" && "$current_version" != "$target_version" ]]; then
    printf 'warning: peer protocol changes from %s to %s; mixed generations may not peer\n' "$current_version" "$target_version"
  fi
}

rollback() {
  acquire_install_lock
  [[ -L "$CURRENT_LINK" ]] || die 'no current generation to roll back'
  [[ -L "$PREVIOUS_LINK" ]] || die 'no previous generation to roll back to'
  local current previous
  current="$(current_generation)"
  local previous_target
  previous_target="$(readlink "$PREVIOUS_LINK")"
  [[ "$previous_target" =~ ^releases/[^/]+$ ]] || die "previous has an unsafe target: $previous_target"
  previous="${previous_target#releases/}"
  [[ -d "$RELEASES_DIR/$previous" ]] || die "previous generation is missing: $previous"
  [[ -f "$RELEASES_DIR/$previous/.generation.json" ]] \
    || die "previous generation has no verified generation metadata: $previous"
  make_work_dir
  verify_installed_release "$RELEASES_DIR/$previous" "$RELEASES_DIR/$previous/.generation.json"
  printf 'fleet-install: %s -> %s (rollback)\n' "$current" "$previous"
  prepare_linux_daemon_service
  prepare_darwin_daemon_service
  daemon_preflight "$previous"
  atomic_link "releases/$previous" "$CURRENT_LINK"
  atomic_link "releases/$current" "$PREVIOUS_LINK"
  restart_linux_daemon_service
  restart_darwin_daemon_service
}

usage() {
  echo 'usage: fleet-install status | latest | <generation> | rollback' >&2
  exit 2
}

main() {
  if [[ "${1:-}" == __validate_fixture ]]; then
    [[ $# -eq 2 ]] || usage
    python3 "$GENERATION_VALIDATOR" fixture "$2"
    return
  fi
  if [[ "${1:-}" == __confirm ]]; then
    [[ $# -eq 4 ]] || usage
    PLATFORM="$(host_platform)"
    CONFIRMATION_DONE="$FLEET_ROOT/.confirmation.$4.log.done"
    confirmation_watchdog "$2" "$3" "$4"
    return
  fi
  if [[ "${1:-}" == __activate ]]; then
    [[ $# -eq 5 ]] || usage
    PLATFORM="$(host_platform)"
    require_generation "$2"
    require_handoff_lock "$5"
    INSTALL_LOCK_PATH="$FLEET_ROOT/.install.lock"
    INSTALL_LOCK_OWNER="$5"
    INSTALL_LOCK_HELD=1
    activate_staged_generation "$2" "$3" "$4"
    printf 'fleet-install: generation %s is installed\n' "$2"
    return
  fi
  [[ $# -eq 1 ]] || usage
  PLATFORM="$(host_platform)"
  case "$1" in
    status)
      READ_ONLY=1
      show_status
      ;;
    latest)
      local generation
      # Allocate in the parent shell so cleanup and the activation handoff
      # retain ownership when latest_generation runs in command substitution.
      make_work_dir
      generation="$(latest_generation)"
      install_generation "$generation"
      ;;
    rollback) rollback ;;
    -h|--help) usage ;;
    *) install_generation "$1" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
